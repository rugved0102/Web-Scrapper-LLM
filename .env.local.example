# ============================================
# INSIGHTENGINE - LOCAL DEVELOPMENT CONFIG
# ============================================
# Copy this file to .env.local for local development
# Replace placeholder values with your actual credentials

# ============================================
# LLM PROVIDER CONFIGURATION
# ============================================
# Primary: Use Groq's free tier for AI analysis
# Options: "groq" (recommended), "lovable" (optional), "mock" (testing only)
LLM_PROVIDER=groq

# --------------------------------------------
# Groq API (FREE TIER - Recommended)
# --------------------------------------------
# Get your free API key from: https://console.groq.com
# Free tier includes generous limits for development
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama3-8b-8192

# --------------------------------------------
# Lovable AI (OPTIONAL FALLBACK)
# --------------------------------------------
# Only needed if you want to use Lovable's AI gateway
# Leave empty if using Groq exclusively
LOVABLE_API_KEY=

# ============================================
# SUPABASE CONFIGURATION (STANDARD)
# ============================================
# These are standard Supabase environment variables
# You can get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Frontend (Client-side) Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Supabase - backend / functions
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --------------------------------------------
# Browserless.io (OPTIONAL - For JS-Heavy Sites)
# --------------------------------------------
# Get your free API key from: https://www.browserless.io
# Free tier: 6 hours/month of browser time
# Enables scraping of JavaScript-heavy sites like Reddit, Twitter/X, Instagram
# Leave empty to use basic HTTP scraping only
BROWSERLESS_API_KEY=

# ============================================
# NOTES FOR INDEPENDENT DEPLOYMENT
# ============================================
# 1. This project runs WITHOUT Lovable after development
# 2. Use Groq free tier for unlimited local development
# 3. Deploy to any platform: Vercel, Railway, Render, etc.
# 4. Supabase Edge Functions can be self-hosted or used via Supabase Cloud
# 5. No vendor lock-in - all services are replaceable
# 6. Browserless.io optional - only needed for Reddit, Twitter, etc.

BACKEND_SECRET_KEY=your_random_secret_key_here
